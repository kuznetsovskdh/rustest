# Скопировать в .env и заполнить своими значениями:
#   cp .env.example .env

POSTGRES_USER=rutest
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rutest

# Хост postgres-rustest — имя сервиса из docker-compose.yml.
# Compose переопределяет эти значения для каждого сервиса; здесь они нужны
# для запуска утилит (alembic, скрипты) вне контейнеров.
AUTH_DB_URL=postgresql://rutest:change_me@postgres-rustest:5432/rutest
TEST_DB_URL=postgresql://rutest:change_me@postgres-rustest:5432/rutest
RESULT_DB_URL=postgresql://rutest:change_me@postgres-rustest:5432/rutest
REFERENCE_DB_URL=postgresql://rutest:change_me@postgres-rustest:5432/rutest

# Общий секрет: им подписывает auth-service и проверяют остальные три сервиса.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=60
